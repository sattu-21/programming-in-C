#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#ifdef _WIN32
    #include <windows.h> // Used for Sleep() on Windows
#else
    #include <unistd.h>  // Used for usleep() on Linux/macOS
#endif

// Function to handle delays across different operating systems
void sleep_ms(int milliseconds) {
#ifdef _WIN32
    Sleep(milliseconds);
#else
    usleep(milliseconds * 1000); // usleep takes microseconds
#endif
}
int main() {
    // Seed the random number generator
    srand(time(NULL));

    // ANSI escape code to change terminal text color to bright green
    printf("\033[1;32m");
    
    // Clear the screen before starting
    printf("\033[H\033[J");

    // An infinite while loop to keep the rain falling
    while (1) {
        int spaces = rand() % 80; // Randomize column alignment
        int characters = rand() % 5 + 1; // Number of characters to print in a row

        // Print random spaces to scatter the "rain" across the terminal width
        for (int i = 0; i < spaces; i++) {
            printf(" ");
        }

        // Print a cluster of random printable ASCII characters
        for (int i = 0; i < characters; i++) {
            char random_char = (rand() % 94) + 33; // Visible ASCII characters (33 to 126)
            printf("%c", random_char);
        }

        printf("\n"); // Move to the next row

        sleep_ms(30); // Pause briefly (30ms) to create a smooth scrolling animation
    }

    return 0; // This line is never reached because of the infinite loop
}


