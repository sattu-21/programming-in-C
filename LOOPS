//for loop used with array

#include <stdio.h>
int main (){
int numbers[5];
for (int i = 0; i < 5; i++){
printf("Enter your number : \n");
scanf("%d", &numbers[i]);
}
for (int i = 4; i >= 0; i--){
printf("%d\n", numbers[i]);
}
return 0;
}



//WAP to print natural no.s from 1 to 30
#include <stdio.h>
int main (){

    for (int x = 1; x<=30; x ++){
        printf("%d\n", x);
    }
    return 0;
} 



