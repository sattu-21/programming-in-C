//for loop used with array

#include <stdio.h>
int main (){
int numbers[5];
for (int i = 0; i < 5; i++){
printf("Enter your number : \n");
scanf("%d", &numbers[i]);
}
for (int i = 4; i >= 0; i--){
printf("%d\n", numbers[i]);
}
return 0;
}



