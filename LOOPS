//for loop used with array

#include <stdio.h>
int main (){
int numbers[5];
for (int i = 0; i < 5; i++){
printf("Enter your number : \n");
scanf("%d", &numbers[i]);
}
for (int i = 4; i >= 0; i--){
printf("%d\n", numbers[i]);
}
return 0;
}



//WAP to print natural no.s from 1 to 30
#include <stdio.h>
int main (){

    for (int x = 1; x<=30; x ++){
        printf("%d\n", x);
    }
    return 0;
} 

#include <stdio.h>
int main (){
int n, i, sum = 0;
for (i = 1; i <= n; i++){
sum += i;
}
printf("The sum of first %d natural numbers is %d", n, sum);
return 0;
}


//Multiplication table (number entered by user)

#include <stdio.h>
int main (){
int i, n;
printf("Enter a number");
scanf("%d", &n);
for (i = 1; i <= 10; i++){
printf("%d x %d = %d\n", n, i, n * i);
}
return 0;
}


//Calculate factorial of a number entered by user
#include <stdio.h>
int main (){
int n, i, fact = 1;
printf("Enter a number");
scanf("%d", &n);
for (i = 1; i <= n; i++){
fact *= i;
}
printf("%d! = %d", n, fact);
if (n <= 0){
printf("Not defined");
}
return 0;
}
