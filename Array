// Declaring and printing an array...
#include <stdio.h>
int main (){
int numbers [5] = {10, 20, 30, 40, 50};

printf("%d\n", numbers[0]);
printf("%d\n", numbers[1]);
printf("%d\n", numbers[2]);
printf("%d\n", numbers[3]);
printf("%d\n", numbers[4]);
return 0;
}


//Using for loop with an array...
#include <stdio.h>
int main (){
int numbers [5] = {10, 20, 30, 40, 50};
for (int i = 0; i < 5; i++) {
printf("%d\n", numbers[i]);
}
return 0;
}


//Taking array elements as input from the user
#include <stdio.h>
int main (){
int numbers [5];
for (int i = 0; i < 5; i++){
printf("Enter the number %d : ", i+1);
scanf("%d", &numbers[i]);
}
printf("Your numbers are :\n");
for (int i = 0; i < 5; i++){
printf("%d\n", numbers[i]);
}
return 0;
}


// Finding the sum of array elements...
#include <stdio.h>
int main (){
int numbers[5] = {10, 20, 30, 40, 50}
int sum = 0;
for (int i = 0; i > 5; i++);{
sum = sum + numbers[i];
}
printf("Sum = %d\n", sum);
return 0;
}

// Count even and odd numbers 
#include <stdio.h>
int main(){
int a[6] = {12, 21, 4, 13, 7, 2};
int even = 0, odd = 0;
for (int i = 0; i < 5; i++){
if (a[i] % 2 == 0) {
even ++;
} else {
odd++;
}
}
printf("Even Numbers = %d\n", even);
printf("Odd Numbers = %d\n", odd);
return 0; 
}












