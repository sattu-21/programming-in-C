#include <stdio.h> 
int main (){
    int math, phy, chem, eng, cs;
    float sum, average;
    printf("Enter the marks of maths:\n");
    scanf("%d", &math);
    printf("Enter the marks of physics:\n");
    scanf("%d", &phy);
    printf("Enter the marks of chemistry:\n");
    scanf("%d", &chem);
    printf("Enter the marks of english:\n");
    scanf("%d", &eng);
    printf("Enter the marks of computer science:\n");
    scanf("%d", &cs);
    sum = math + phy + chem + eng + cs;
    average = sum / 5.0;
    printf("The total marks are %f and the average is %f", sum, average);
    return 0;
}
