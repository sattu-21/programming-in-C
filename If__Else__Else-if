//WAP to check a student is failed or passed 

#include <stdio.h>
int main(){
    int score;
    printf("Enter your score:\n");
    scanf("%d", &score);
    if (score >= 50){
        printf("Your are passed!\n");
    }else {
        printf("You are failed!\n");
    }
    return 0;

}



// even or odd using if-else
#include <stdio.h>
int main(){
int num = 7;
if (num % 2 == 0){
printf("%d is even\n", num);
} else {
printf("%d is odd\n, num");
}
return 0;
}


//WAP to find the type of triangle
#include <stdio.h>

int main()
{
    int a, b, c;

    printf("Enter three sides of triangle: ");
    scanf("%d %d %d", &a, &b, &c);

    if (a <= 0 || b <= 0 || c <= 0 ||
        a + b <= c || a + c <= b || b + c <= a)
    {
        printf("Invalid triangle");
    }
    else if (a == b && b == c)
    {
        printf("Equilateral triangle");
    }
    else if (a == b || b == c || a == c)
    {
        printf("Isosceles triangle");
    }
    else
    {
        printf("Scalene triangle");
    }

    return 0;
}
