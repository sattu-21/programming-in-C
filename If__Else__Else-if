//WAP to check a student is failed or passed 

#include <stdio.h>
int main(){
    int score;
    printf("Enter your score:\n");
    scanf("%d", &score);
    if (score >= 50){
        printf("Your are passed!\n");
    }else {
        printf("You are failed!\n");
    }
    return 0;

}



// even or odd using if-else
#include <stdio.h>
int main(){
int num = 7;
if (num % 2 == 0){
printf("%d is even\n", num);
} else {
printf("%d is odd\n, num");
}
return 0;
}
